# Template of /opt/storage-api/.env on the server. The deploy never touches it.
# Create it with:  install -m 600 -o deploy -g deploy /dev/null /opt/storage-api/.env

APP_ENV=production
HTTP_PORT=8084

# Dedicated database and role on the shared PostgreSQL. Host = container name on the
# network atm-network. That server has no TLS, so sslmode=disable.
DATABASE_URL=postgres://storage_app:<DB_PASSWORD>@atm-postgres:5432/storage?sslmode=disable

# Cloudflare R2, PRODUCTION bucket (must end with -prod). Use an S3 key restricted to that
# bucket, never the development one.
STORAGE_PROVIDER=r2
STORAGE_BUCKET=atm-storage-prod
STORAGE_REGION=auto
STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# PUBLIC half of the production auth-api key and its issuer (JWT_ISSUER in /opt/auth-api/.env).
# Derive it on the server, never copy the private key:
#   grep ^JWT_PRIVATE_KEY= /opt/auth-api/.env | cut -d= -f2- | base64 -d | openssl pkey -pubout | base64 | tr -d '\n'
AUTH_PUBLIC_KEY_BASE64=
AUTH_ISSUER=atm-auth-api

# Browser origins allowed. The console calls /storage-api on its own origin, but browsers
# still send Origin on POST/DELETE.
WEB_CORS_ORIGINS=https://console.atmosferast.com

MAX_UPLOAD_BYTES=26214400
MAX_LOGO_BYTES=2097152
DOWNLOAD_URL_TTL=5m
