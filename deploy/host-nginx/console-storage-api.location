# Added inside the `server` block of /etc/nginx/sites-available/console.atmosferast.com,
# before `location /`. The console calls the storage API on its own origin under
# /storage-api (the trailing slash in proxy_pass removes that prefix), like /v1 for auth-api.
	location /storage-api/ {
		client_max_body_size 26m;
		proxy_pass http://127.0.0.1:3132/;
		proxy_http_version 1.1;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $auth_client_ip;
		proxy_set_header X-Forwarded-For $auth_client_ip;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_read_timeout 95s;
		proxy_send_timeout 95s;
	}

