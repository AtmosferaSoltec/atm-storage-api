                }
              }
            }
          },
          "200": {
            "description": "Temporary bearer URL; do not persist",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "url",
                    "expires_at"
                  ],
                  "properties": {
                    "url": {
                      "type": "string",
