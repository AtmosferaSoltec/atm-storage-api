    "/v1/files/{id}/preview": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "operationId": "previewFile",
        "responses": {
          "400": {
            "description": "Invalid input",
