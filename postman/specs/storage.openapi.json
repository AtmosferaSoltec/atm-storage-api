  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "RS256 JWT from atm-auth-api"
      }
    },
    "schemas": {
      "File": {
        "type": "object",
        "required": [
          "id",
          "company_id",
          "system",
          "scope",
          "purpose",
          "filename",
          "content_type",
          "size",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "company_id": {
            "type": "string",
            "format": "uuid"
          },
          "system": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "content_type": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "FilePage": {
        "type": "object",
        "required": [
          "items",
          "total"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/File"
            }
          },
          "total": {
            "type": "integer"
          }
        }
      },
      "UsageSummary": {
        "type": "object",
        "required": [
          "files_count",
          "total_bytes",
          "usage"
        ],
        "properties": {
          "files_count": {
            "type": "integer"
          },
          "total_bytes": {
            "type": "integer"
          },
          "usage": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "scope",
                "system",
                "files_count",
                "total_bytes"
              ],
              "properties": {
                "scope": {
                  "type": "string"
                },
                "system": {
                  "type": "string",
                  "description": "Empty for shared company assets"
                },
                "files_count": {
                  "type": "integer"
                },
                "total_bytes": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    }
  }
}
